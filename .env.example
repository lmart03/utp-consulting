# Variables locales de desarrollo. Copiar a .env y completar.
# Spring Boot lo carga vía spring.config.import y Docker Compose lo lee automáticamente.

# Google OAuth 2.0 (Web application) - pega aquí tus credenciales
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# PostgreSQL (compose.yaml)
DB_HOST=localhost
DB_PORT=2340
DB_NAME=utp_assistant
DB_USERNAME=utp
DB_PASSWORD=utp_dev_password

# Gemini API (Google AI Studio)
GEMINI_API_KEY=tu-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash

# Jira Cloud (REST API v3, Basic Auth con email + API token de id.atlassian.com)
JIRA_BASE_URL=https://utp-tics.atlassian.net
JIRA_EMAIL=tu-email@dominio.com
JIRA_API_TOKEN=tu-jira-api-token
JIRA_PROJECT_KEY=SCRUM
# JIRA_ISSUE_TYPE=Task
